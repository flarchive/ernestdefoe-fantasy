{
    "name": "ernestdefoe/fantasy",
    "description": "A season-long fantasy league where members draft TEAMS rather than players. Snake draft, weekly lineups that lock at each team's own kickoff, head-to-head matchups, and a scoring system the commissioner sets. Plays whatever competition the Picks season is, and starts each league from that sport's own numbers.",
    "type": "flarum-extension",
    "keywords": ["flarum", "extension", "fantasy", "pickem", "college football", "nfl", "sports"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ernestdefoe/fantasy/issues",
        "source": "https://github.com/ernestdefoe/fantasy"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "ernestdefoe/picks": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Fantasy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Fantasy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Fantasy",
            "category": "feature",
            "icon": {
                "name": "fas fa-trophy",
                "backgroundColor": "#b45309",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
